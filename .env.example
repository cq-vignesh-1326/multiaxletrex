# Database (MongoDB Atlas). The path segment is the database name.
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@farmconnect-dev.bm7wxvl.mongodb.net/multiaxletrex?retryWrites=true&w=majority&appName=multiaxletrex

# Signs the login cookie (random 32+ chars)
JWT_SECRET=change_me

# Sent as the x-superadmin-secret header to POST /api/auth/setup (creates an office + owner login)
SUPERADMIN_SECRET=change_me

NODE_ENV=development
